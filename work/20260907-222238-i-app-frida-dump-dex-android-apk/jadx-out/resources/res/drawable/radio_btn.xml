<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_window_focused="false"
        android:state_checked="true">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/checked"/>
        </layer-list>
    </item>
    <item
        android:state_window_focused="false"
        android:state_checked="false">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/unchecked"/>
        </layer-list>
    </item>
    <item
        android:state_checked="true"
        android:state_pressed="true">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/checked"/>
        </layer-list>
    </item>
    <item
        android:state_checked="false"
        android:state_pressed="true">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/unchecked"/>
        </layer-list>
    </item>
    <item
        android:state_focused="true"
        android:state_checked="true">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/checked"/>
        </layer-list>
    </item>
    <item
        android:state_focused="true"
        android:state_checked="false">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/unchecked"/>
        </layer-list>
    </item>
    <item android:state_checked="false">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/unchecked"/>
        </layer-list>
    </item>
    <item android:state_checked="true">
        <layer-list>
            <item
                android:height="20dp"
                android:width="20dp"
                android:drawable="@drawable/checked"/>
        </layer-list>
    </item>
</selector>
