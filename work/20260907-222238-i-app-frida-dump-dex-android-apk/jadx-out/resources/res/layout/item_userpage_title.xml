<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/title_bg"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:src="@mipmap/userpage_title_bg"
        android:scaleType="fitStart"
        app:layout_constraintDimensionRatio="h,750:400"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:orientation="horizontal"
        android:id="@+id/get_num_identity"
        android:background="@drawable/shape_gradient_red_bg"
        android:paddingLeft="15dp"
        android:paddingTop="6dp"
        android:paddingRight="18dp"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginBottom="26dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="29dp">
            <ImageView
                android:id="@+id/ivNumIdentity"
                android:layout_width="29dp"
                android:layout_height="29dp"
                android:layout_marginRight="4dp"
                android:src="@mipmap/icon_num_indentity"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/white"
                android:ellipsize="end"
                android:id="@+id/content"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_weight="1"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/tvSetupBirthday"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="4.5dp"
                android:text="点击前往"/>
            <ImageView
                android:id="@+id/num_identity_arrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@mipmap/right_arrow_white"/>
        </LinearLayout>
    </FrameLayout>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/gray_33"
        android:gravity="center_vertical"
        android:background="@drawable/shape_bg_white_8dp_top"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:text="@string/my_order"
        android:paddingStart="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <ImageView
        android:id="@+id/avatar"
        android:layout_width="51dp"
        android:layout_height="51dp"
        android:layout_marginBottom="108dp"
        android:layout_marginStart="15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"/>
    <View
        android:id="@+id/redDotAvatar"
        android:background="@drawable/bg_message_red_dot"
        android:visibility="visible"
        android:layout_width="7dp"
        android:layout_height="7dp"
        android:layout_marginTop="3.5dp"
        android:layout_marginRight="5.5dp"
        app:layout_constraintRight_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/name_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        app:layout_constraintLeft_toRightOf="@+id/avatar"
        app:layout_constraintTop_toTopOf="@+id/avatar">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#c89f4e"
            android:id="@+id/user_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp">
            <TextView
                android:textSize="10dp"
                android:textColor="@color/mt_red"
                android:id="@+id/has_real_name"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/mt_red"
                android:id="@+id/num_identity_status"
                android:paddingLeft="4dp"
                android:paddingRight="4dp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
            <ImageView
                android:id="@+id/arrow"
                android:visibility="gone"
                android:layout_width="4dp"
                android:layout_height="7.5dp"
                android:src="@mipmap/red_arrow"
                android:layout_marginStart="1dp"/>
        </LinearLayout>
    </LinearLayout>
    <ImageView
        android:id="@+id/setting"
        android:padding="3dp"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:src="@mipmap/ic_setting"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/name_layout"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/name_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
