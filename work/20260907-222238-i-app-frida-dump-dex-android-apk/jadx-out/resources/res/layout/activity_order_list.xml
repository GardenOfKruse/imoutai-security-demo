<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray_f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.drake.statelayout.StateLayout
        android:id="@+id/order_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <com.netease.hearttouch.htrefreshrecyclerview.HTRefreshRecyclerView
            android:id="@+id/content_container_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/yx_margin"/>
    </com.drake.statelayout.StateLayout>
</FrameLayout>
