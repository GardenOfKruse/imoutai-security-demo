<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vShadow"
        android:background="@color/black_alpha50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/vShadowClose"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/flTitle"
        app:layout_constraintTop_toTopOf="parent"/>
    <FrameLayout
        android:id="@+id/flTitle"
        android:background="@drawable/shape_radius_12_top_round_bg"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="109dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="18dp"
            android:textColor="@color/gray_33"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="关联的商品"/>
        <View
            android:layout_gravity="center"
            android:id="@+id/vClose"
            android:background="@mipmap/birthday_selector_dialog_close"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginRight="15dp"/>
    </FrameLayout>
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvList"
        android:background="@color/gray_f8"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingHorizontal="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
