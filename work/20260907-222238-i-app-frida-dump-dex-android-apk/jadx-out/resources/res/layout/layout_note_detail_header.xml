<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutHeaderWithBg"
    android:layout_width="match_parent"
    android:layout_height="44dp">
    <ImageView
        android:id="@+id/ivBack"
        android:padding="8dp"
        android:layout_width="24.5dp"
        android:layout_height="32dp"
        android:layout_marginLeft="7dp"
        android:src="@mipmap/icon_note_detail_back"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginLeft="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintLeft_toRightOf="@+id/ivBack"
        app:layout_constraintTop_toTopOf="@+id/ivBack"/>
    <ImageView
        android:id="@+id/ivAvatarFrame"
        android:layout_width="36.5dp"
        android:layout_height="36.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintLeft_toLeftOf="@+id/ivAvatar"
        app:layout_constraintRight_toRightOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/gray_33"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="5.5dp"
        android:lines="1"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintLeft_toRightOf="@+id/ivAvatar"
        app:layout_constraintRight_toLeftOf="@+id/ivAuth"
        app:layout_constraintTop_toTopOf="@+id/ivBack"
        app:layout_goneMarginRight="5dp"/>
    <ImageView
        android:id="@+id/ivAuth"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="15dp"
        android:layout_marginLeft="5dp"
        android:layout_marginRight="5dp"
        android:src="@mipmap/icon_community_auth"
        app:layout_constraintBottom_toBottomOf="@+id/tvName"
        app:layout_constraintLeft_toRightOf="@+id/tvName"
        app:layout_constraintRight_toLeftOf="@+id/btnFollow"
        app:layout_constraintTop_toTopOf="@+id/tvName"/>
    <Button
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/btnFollow"
        android:background="@drawable/shape_note_detail_follow_btn"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:layout_marginRight="15dp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="@+id/ivBack"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivBack"/>
</androidx.constraintlayout.widget.ConstraintLayout>
