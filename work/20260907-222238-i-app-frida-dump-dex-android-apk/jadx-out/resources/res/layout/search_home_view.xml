<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:id="@+id/history_record_head"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="历史搜索"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_99"
            android:id="@+id/tvHistoryClear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="清除全部搜索记录"
            android:layout_marginEnd="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/history_record_head"
            app:layout_constraintEnd_toStartOf="@+id/history_record_clear"
            app:layout_constraintTop_toTopOf="@+id/history_record_head"/>
        <View
            android:id="@+id/history_record_clear"
            android:background="@mipmap/ic_search_clear_all"
            android:layout_width="9.5dp"
            android:layout_height="9.5dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintBottom_toBottomOf="@+id/history_record_head"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/history_record_head"/>
        <com.moutai.mall.view.FlowLayout
            android:id="@+id/histories"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="15dp"
            android:layout_marginHorizontal="15dp"
            app:horizontalSpace="16dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/history_record_head"
            app:verticalSpace="10dp"/>
        <TextView
            android:id="@+id/tvSearchExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:drawablePadding="6dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/histories"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutGuess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@+id/layoutHistory">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:id="@+id/tvGuessTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="猜你想搜"
            android:layout_marginStart="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_99"
            android:id="@+id/tvGuessRefresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="换一批"
            android:layout_marginEnd="7dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvGuessTitle"
            app:layout_constraintEnd_toStartOf="@+id/vGuessRefresh"
            app:layout_constraintTop_toTopOf="@+id/tvGuessTitle"/>
        <View
            android:id="@+id/vGuessRefresh"
            android:background="@mipmap/ic_search_refresh"
            android:layout_width="9.5dp"
            android:layout_height="9.5dp"
            android:layout_marginEnd="17dp"
            app:layout_constraintBottom_toBottomOf="@+id/tvGuessTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvGuessTitle"/>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvGuessList"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:paddingHorizontal="15dp"
            app:layout_constraintTop_toBottomOf="@+id/tvGuessTitle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</merge>
