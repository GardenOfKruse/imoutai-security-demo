<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="12dp"
        android:textColor="@color/yellow"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tips"
        android:background="#3ff48f18"
        android:paddingLeft="13dp"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:lines="1"
        android:drawableLeft="@mipmap/icon_online_shop_notification"
        android:drawablePadding="10dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.drake.statelayout.StateLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/controler_layout"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tips">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/reservation_rv"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.drake.statelayout.StateLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/controler_layout"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent">
        <View
            android:id="@+id/divide"
            android:background="@color/gray_d9"
            android:layout_width="match_parent"
            android:layout_height="1dp"/>
        <RelativeLayout
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/all_select"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:layout_marginHorizontal="10dp">
                <View
                    android:id="@+id/all_select_state"
                    android:background="@drawable/selector_shopping_cart_item_choose"
                    android:layout_width="18dp"
                    android:layout_height="18dp"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/gray_7f"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="4dp"
                    android:text="@string/select_all"/>
            </LinearLayout>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/mt_red"
                android:gravity="right"
                android:id="@+id/tvTotalPrice"
                android:layout_width="wrap_content"
                android:layout_height="17dp"
                android:layout_marginLeft="4dp"
                android:lines="1"
                android:layout_toLeftOf="@+id/tvPurchase"
                android:layout_toRightOf="@+id/all_select"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvPurchase"
                android:background="@drawable/selector_shoppingcart_purchase_bt"
                android:clickable="true"
                android:layout_width="112dp"
                android:layout_height="36dp"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"
                android:text="结算"
                android:lines="1"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
