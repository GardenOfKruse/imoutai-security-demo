<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:ShSwitchView="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray_f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cl_content"
        android:background="@drawable/shape_radius_6_all_round_bg"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="15dp"
        ShSwitchView:layout_constraintLeft_toLeftOf="parent"
        ShSwitchView:layout_constraintRight_toRightOf="parent"
        ShSwitchView:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gray_33"
            android:gravity="start|center_vertical"
            android:id="@+id/name"
            android:paddingLeft="15dp"
            android:layout_width="107dp"
            android:layout_height="55dp"
            android:text="姓名"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gray_33"
            android:gravity="start|center_vertical"
            android:id="@+id/mobile"
            android:paddingLeft="15dp"
            android:layout_width="107dp"
            android:layout_height="55dp"
            android:text="手机号"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/line_one"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gray_33"
            android:gravity="start|center_vertical"
            android:id="@+id/district"
            android:paddingLeft="15dp"
            android:layout_width="107dp"
            android:layout_height="55dp"
            android:text="所在地区"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/mobile"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gray_33"
            android:gravity="start|center_vertical"
            android:id="@+id/address"
            android:paddingLeft="15dp"
            android:layout_width="107dp"
            android:layout_height="55dp"
            android:text="详细地址"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/district"/>
        <EditText
            android:textSize="14dp"
            android:textColorHint="@color/gray_99"
            android:gravity="center"
            android:id="@+id/name_edit"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="17.5dp"
            android:layout_marginRight="15dp"
            android:minHeight="20dp"
            android:hint="请填写收货人姓名"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"
            ShSwitchView:layout_constraintLeft_toRightOf="@+id/name"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toTopOf="parent"/>
        <View
            android:id="@+id/line_one"
            android:background="@color/gray_f8"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="14dp"
            android:layout_marginTop="17.5dp"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/name_edit"/>
        <View
            android:id="@+id/line_two"
            android:background="@color/gray_f8"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="14dp"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/mobile_edit"/>
        <View
            android:id="@+id/line_three"
            android:background="@color/gray_f8"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_marginLeft="14dp"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/district_edit"/>
        <EditText
            android:textSize="14dp"
            android:textColorHint="@color/gray_99"
            android:gravity="center"
            android:id="@+id/mobile_edit"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginRight="15dp"
            android:hint="请填写收货人手机号"
            android:lines="1"
            android:inputType="number"
            android:imeOptions="actionDone"
            ShSwitchView:layout_constraintLeft_toRightOf="@+id/name"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/line_one"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/yx_red"
            android:id="@+id/tv_update_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="15dp"
            android:drawablePadding="4dp"
            android:drawableEnd="@mipmap/right_arrow"
            ShSwitchView:layout_constraintBottom_toBottomOf="@+id/district_edit"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toTopOf="@+id/district_edit"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gray_33"
            android:textColorHint="@color/gray_99"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/district_edit"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginRight="5dp"
            android:hint="请选择省市区县"
            android:lines="1"
            ShSwitchView:layout_constraintLeft_toRightOf="@+id/name"
            ShSwitchView:layout_constraintRight_toLeftOf="@+id/tv_update_address"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/mobile_edit"/>
        <EditText
            android:textSize="14dp"
            android:textColorHint="@color/gray_99"
            android:gravity="center"
            android:id="@+id/address_edit"
            android:background="@null"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="17.5dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="17.5dp"
            android:minHeight="20dp"
            android:hint="街道、门牌号"
            android:inputType="textMultiLine"
            android:imeOptions="actionDone"
            ShSwitchView:layout_constraintBottom_toBottomOf="parent"
            ShSwitchView:layout_constraintLeft_toRightOf="@+id/name"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toBottomOf="@+id/line_three"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/white"
        android:id="@+id/save_address"
        android:layout_width="0dp"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="40dp"
        android:text="保 存"
        ShSwitchView:cornerRadius="22dp"
        ShSwitchView:layout_constraintBottom_toBottomOf="parent"
        ShSwitchView:layout_constraintLeft_toLeftOf="parent"
        ShSwitchView:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="@drawable/shape_radius_6_all_round_bg"
        android:layout_width="0dp"
        android:layout_height="55dp"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="12dp"
        android:layout_marginRight="15dp"
        ShSwitchView:layout_constraintLeft_toLeftOf="parent"
        ShSwitchView:layout_constraintRight_toRightOf="parent"
        ShSwitchView:layout_constraintTop_toBottomOf="@+id/cl_content">
        <TextView
            android:textSize="14dp"
            android:textColor="@color/gray_33"
            android:gravity="start|center_vertical"
            android:paddingLeft="15dp"
            android:layout_width="107dp"
            android:layout_height="55dp"
            android:text="设为默认"
            ShSwitchView:layout_constraintLeft_toLeftOf="parent"
            ShSwitchView:layout_constraintTop_toTopOf="parent"/>
        <com.moutai.mall.view.ShSwitchView
            android:id="@+id/switch_default"
            android:layout_width="44dp"
            android:layout_height="27dp"
            android:layout_marginRight="15dp"
            ShSwitchView:knobBoundColor="@color/white"
            ShSwitchView:layout_constraintBottom_toBottomOf="parent"
            ShSwitchView:layout_constraintRight_toRightOf="parent"
            ShSwitchView:layout_constraintTop_toTopOf="parent"
            ShSwitchView:outerStrokeWidth="0.5dp"
            ShSwitchView:shadowSpace="0dp"
            ShSwitchView:tintColor="#44db5e"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
