<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlRoot"
    android:background="@drawable/shape_radius_12_all_round_bg"
    android:paddingLeft="18dp"
    android:paddingTop="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginBottom="12dp">
    <RelativeLayout
        android:id="@+id/layoutName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginRight="18dp">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:ellipsize="end"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="2"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="12dp"
            android:textColor="@color/gray_7f"
            android:ellipsize="end"
            android:id="@+id/tvAddr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:lines="1"
            android:drawableLeft="@mipmap/ic_addr_gray"
            android:drawablePadding="4dp"
            android:layout_below="@+id/tvName"/>
    </RelativeLayout>
    <View
        android:id="@+id/vDivider"
        android:background="@color/gray_f8"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="18dp"
        android:layout_below="@+id/layoutName"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gray_7f"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvDistance"
        android:layout_width="85dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:layout_alignTop="@+id/layoutReservationBtn"
        android:layout_alignBottom="@+id/layoutReservationBtn"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutReservationBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="85dp"
        android:layout_marginTop="6dp"
        android:layout_marginRight="18dp"
        android:layout_marginBottom="12dp"
        android:layout_below="@+id/vDivider">
        <com.google.android.material.button.MaterialButton
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/btReserve"
            android:padding="0dp"
            android:layout_width="59dp"
            android:layout_height="23dp"
            android:text="申购"
            app:cornerRadius="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_33"
            android:id="@+id/tvInventoryHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="名额"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:ellipsize="end"
            android:id="@+id/tvInventoryNum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tvInventoryHint"
            app:layout_constraintRight_toLeftOf="@+id/tvReservationStatus"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_33"
            android:id="@+id/tvReservationStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="57dp"
            android:text="已申购"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:ellipsize="end"
            android:id="@+id/tvReservationNum"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:lines="1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintLeft_toRightOf="@+id/tvReservationStatus"
            app:layout_constraintRight_toLeftOf="@+id/btReserve"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/ivNotSupportReservation"
        android:visibility="gone"
        android:layout_width="60dp"
        android:layout_height="@dimen/size_60dp"
        android:layout_marginBottom="-12dp"
        android:src="@mipmap/icon_not_support_reservation"
        android:layout_alignBottom="@+id/layoutReservationBtn"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
