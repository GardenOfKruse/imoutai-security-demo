<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:id="@+id/llSearchRoot"
        android:background="@color/white"
        android:paddingTop="@dimen/size_8dp"
        android:paddingBottom="@dimen/size_8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llSearchContainer"
            android:background="@drawable/bg_search_input"
            android:padding="@dimen/size_8dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_4dp"
            android:layout_marginBottom="@dimen/size_4dp"
            android:layout_marginStart="@dimen/size_16dp"
            android:layout_marginEnd="@dimen/size_16dp">
            <EditText
                android:textSize="12sp"
                android:textColor="#9d9d9d"
                android:id="@+id/etSearch"
                android:background="@null"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:hint="请输入门店名称/门店编号或门店地址"
                android:maxLines="1"
                android:layout_weight="1"
                android:paddingStart="@dimen/size_8dp"
                android:paddingEnd="@dimen/size_8dp"/>
            <View
                android:layout_gravity="center_vertical"
                android:id="@+id/vSearchDivider"
                android:background="#c9c8c8"
                android:layout_width="1dp"
                android:layout_height="15dp"
                android:layout_marginTop="@dimen/size_1dp"
                android:layout_marginStart="@dimen/size_8dp"
                android:layout_marginEnd="@dimen/size_6dp"/>
            <LinearLayout
                android:gravity="center_vertical"
                android:layout_gravity="center_vertical"
                android:orientation="horizontal"
                android:id="@+id/llSearchBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="@dimen/size_2dp"
                android:paddingEnd="@dimen/size_8dp">
                <TextView
                    android:textSize="14sp"
                    android:typeface="sans"
                    android:textStyle="bold"
                    android:textColor="#c89f4e"
                    android:id="@+id/tvSearchBtnText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="搜索"
                    android:layout_marginEnd="@dimen/size_4dp"/>
                <ImageView
                    android:id="@+id/ivSearchIcon"
                    android:layout_width="@dimen/size_14dp"
                    android:layout_height="@dimen/size_14dp"
                    android:layout_marginTop="@dimen/size_1dp"
                    android:src="@mipmap/ic_shop_search"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <com.drake.statelayout.StateLayout
        android:id="@+id/slRoot"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/llSearchRoot">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_shop_preference_list"
            android:background="@color/gray_f8"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.drake.statelayout.StateLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
