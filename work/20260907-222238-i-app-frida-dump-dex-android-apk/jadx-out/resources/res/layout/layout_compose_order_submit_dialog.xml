<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/black_alpha50"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/iv_bg"
        android:layout_width="315dp"
        android:layout_height="353dp"
        android:src="@mipmap/bg_compose_order_submit_dialog"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textColor="#cf2d26"
        android:gravity="center"
        android:id="@+id/tv_btn_left"
        android:background="@drawable/shape_order_submit_dialog_button_left"
        android:layout_width="135dp"
        android:layout_height="44dp"
        android:layout_marginLeft="15dp"
        android:layout_marginBottom="24dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/tv_btn_right"
        android:background="@drawable/shape_order_submit_dialog_button_right"
        android:layout_width="135dp"
        android:layout_height="44dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="24dp"
        android:includeFontPadding="false"
        app:layout_constraintBottom_toBottomOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/gray_33"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/tv_msg"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginLeft="45dp"
        android:layout_marginTop="183dp"
        android:layout_marginRight="45dp"
        android:maxLines="3"
        android:layout_marginHorizontal="45dp"
        app:layout_constraintBottom_toTopOf="@+id/tv_btn_left"
        app:layout_constraintLeft_toLeftOf="@+id/iv_bg"
        app:layout_constraintRight_toRightOf="@+id/iv_bg"
        app:layout_constraintTop_toTopOf="@+id/iv_bg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
