<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vShadow"
        android:background="@color/black_alpha50"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/llList"
        app:layout_constraintTop_toTopOf="parent"/>
    <LinearLayout
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:id="@+id/llList"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="618dp"
        app:layout_constraintBottom_toBottomOf="parent">
        <FrameLayout
            android:id="@+id/flTitle"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="60dp">
            <TextView
                android:textSize="18dp"
                android:textColor="@color/gray_33"
                android:layout_gravity="center"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="优惠券"/>
            <View
                android:layout_gravity="center"
                android:id="@+id/vClose"
                android:background="@mipmap/dialog_close"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginRight="15dp"/>
        </FrameLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:background="@color/gray_f8"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"/>
        <FrameLayout
            android:background="@color/white"
            android:paddingLeft="15dp"
            android:paddingTop="7.5dp"
            android:paddingRight="15dp"
            android:paddingBottom="7.5dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/tvCouponConfirm"
                android:background="@drawable/shape_bg_gold_50dp_all"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:text="确认"/>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
