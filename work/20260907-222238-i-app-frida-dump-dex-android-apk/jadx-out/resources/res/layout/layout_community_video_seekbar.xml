<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="40dp">
    <SeekBar
        android:id="@+id/controller_seek_bar"
        android:paddingTop="11dp"
        android:paddingBottom="27dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:progressDrawable="@drawable/seek_bar_community_video_detail"
        android:minHeight="2dp"
        android:thumb="@mipmap/icon_community_video_seekbar_thumb"
        android:thumbOffset="0dp"
        android:paddingStart="0dp"
        android:paddingEnd="0dp"
        android:layout_marginHorizontal="15dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/tvVideoTimeUpdate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:12"
        app:layout_constraintBottom_toBottomOf="@+id/controller_seek_bar"
        app:layout_constraintLeft_toLeftOf="@+id/controller_seek_bar"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/white"
        android:id="@+id/tvVideoTimeTotal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="12:30"
        app:layout_constraintBottom_toBottomOf="@+id/controller_seek_bar"
        app:layout_constraintRight_toRightOf="@+id/controller_seek_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
