<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/gray_f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/size_72dp"
        android:layout_marginTop="@dimen/size_10dp"
        android:src="@mipmap/xiaomao_indicator"
        android:scaleType="fitCenter"/>
    <LinearLayout
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:background="@drawable/shape_radius_8_all_round_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/yx_margin"
        android:layout_marginTop="@dimen/size_75dp"
        android:layout_marginRight="@dimen/yx_margin">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clock_container"
            android:background="@mipmap/order_qr_clock_bg"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="@dimen/size_120dp">
            <TextView
                android:textSize="@dimen/size_16dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toTopOf="@+id/millis"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="@dimen/size_32dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:gravity="left"
                android:id="@+id/time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintRight_toLeftOf="@+id/millis"
                app:layout_constraintTop_toBottomOf="@+id/date"
                app:layout_constraintVertical_chainStyle="packed"/>
            <TextView
                android:textSize="@dimen/size_32dp"
                android:textStyle="bold"
                android:textColor="@color/order_qr_code_millis_color"
                android:gravity="center"
                android:id="@+id/millis"
                android:background="@drawable/shape_circle_white_bg"
                android:layout_width="@dimen/size_40dp"
                android:layout_height="@dimen/size_40dp"
                android:layout_marginLeft="@dimen/size_12dp"
                android:includeFontPadding="false"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toRightOf="@+id/time"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/date"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <FrameLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_20dp">
            <ImageView
                android:id="@+id/qr_code_img"
                android:layout_width="@dimen/order_qrcode_image_size"
                android:layout_height="@dimen/order_qrcode_image_size"/>
            <View
                android:id="@+id/qr_code_mask"
                android:background="@color/black_alpha80"
                android:visibility="gone"
                android:layout_width="@dimen/order_qrcode_image_size"
                android:layout_height="@dimen/order_qrcode_image_size"/>
            <TextView
                android:textSize="@dimen/yx_text_size_l"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_gravity="center"
                android:id="@+id/invalid_desc"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pick_up_code_invalid_desc"/>
        </FrameLayout>
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_99"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/size_8dp"
            android:layout_marginBottom="@dimen/size_30dp"
            android:text="@string/order_qr_update_desc"/>
    </LinearLayout>
</FrameLayout>
