<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/goods_container"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/mt_goods_pic"
            android:layout_width="@dimen/size_90dp"
            android:layout_height="@dimen/size_90dp"
            android:layout_marginLeft="@dimen/size_12dp"
            android:layout_marginTop="@dimen/size_15dp"
            android:layout_marginBottom="@dimen/size_15dp"/>
        <LinearLayout
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="@dimen/size_20dp"
            android:layout_marginRight="@dimen/size_14dp"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/yx_text_size_xm"
                android:textColor="@color/gray_33"
                android:ellipsize="end"
                android:id="@+id/mt_goods_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"/>
            <TextView
                android:textSize="@dimen/yx_text_size_l"
                android:textColor="@color/gray_33"
                android:id="@+id/mt_goods_spec"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_5dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_13dp">
                <TextView
                    android:textSize="@dimen/yx_text_size_l"
                    android:textColor="@color/gray_33"
                    android:id="@+id/mt_goods_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1"/>
                <ImageView
                    android:layout_gravity="center_vertical"
                    android:id="@+id/mt_goods_num_prefix"
                    android:layout_width="@dimen/size_6dp"
                    android:layout_height="@dimen/size_6dp"
                    android:layout_marginTop="@dimen/size_3dp"
                    android:layout_marginRight="@dimen/size_3dp"
                    android:src="@mipmap/pay_goods_num_prefix"/>
                <TextView
                    android:textSize="@dimen/yx_text_size_l"
                    android:textColor="@color/gray_33"
                    android:id="@+id/mt_goods_num"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:layout_gravity="bottom"
        android:id="@+id/mt_goods_sep"
        android:background="@color/gray_f8"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_px"
        android:layout_marginLeft="@dimen/size_12_5dp"/>
</FrameLayout>
