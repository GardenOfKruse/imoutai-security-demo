<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/gray_32"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ht.uk.co.senab.photoview.PhotoView
        android:layout_gravity="start"
        android:id="@+id/img_fullscreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <ProgressBar
        android:layout_gravity="center"
        android:id="@+id/progress_fullscreen"
        android:background="@drawable/shape_round_20dp_grey_transparent"
        android:padding="20dp"
        android:visibility="gone"
        android:layout_width="61dp"
        android:layout_height="61dp"
        android:indeterminate="false"
        android:indeterminateDrawable="@anim/anim_loading_center_small"/>
</FrameLayout>
