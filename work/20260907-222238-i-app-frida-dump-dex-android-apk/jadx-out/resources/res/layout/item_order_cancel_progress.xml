<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/progress_sep"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_32dp"/>
    <LinearLayout
        android:id="@+id/progress_item_root"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <LinearLayout
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:layout_width="@dimen/size_20dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_23dp">
            <TextView
                android:textSize="@dimen/yx_text_size_m"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/progress_index_ic"
                android:layout_width="@dimen/size_20dp"
                android:layout_height="@dimen/size_20dp"/>
            <com.moutai.mall.module.order.view.DashView
                android:id="@+id/progress_dash_line"
                android:layout_width="@dimen/one_px"
                android:layout_height="match_parent"
                app:dashOrientation="1"
                app:dashWidth="@dimen/size_1dp"
                app:lineColor="@color/gray_cc"
                app:lineHeight="@dimen/size_1dp"
                app:lineWidth="@dimen/one_px"/>
        </LinearLayout>
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/size_16dp"
            android:layout_marginRight="@dimen/size_43dp"
            android:layout_weight="1">
            <TextView
                android:textSize="@dimen/yx_text_size_l"
                android:textColor="@color/gray_33"
                android:id="@+id/progress_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
            <TextView
                android:textColor="@color/gray_7f"
                android:id="@+id/progress_date"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/size_3dp"/>
            <View
                android:layout_width="wrap_content"
                android:layout_height="@dimen/size_45dp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
