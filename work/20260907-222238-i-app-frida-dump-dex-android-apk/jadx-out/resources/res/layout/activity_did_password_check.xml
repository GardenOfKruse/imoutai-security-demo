<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textSize="16dp"
        android:textColor="@color/gray_33"
        android:id="@+id/hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="94dp"
        android:text="请输入6位数字身份密码"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.moutai.mall.module.did.PasswordEditText
        android:textSize="32dp"
        android:id="@+id/pwd"
        android:focusableInTouchMode="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:maxLength="6"
        android:inputType="number"
        app:layout_constraintLeft_toLeftOf="@+id/hint"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint"
        app:psw_border_color="@color/gray_33"
        app:psw_border_selected_color="@color/gray_33"
        app:psw_border_width="2dp"
        app:psw_cover_circle_radius="4dp"
        app:psw_item_margin="20dp"
        app:psw_mode="Circle"
        app:psw_show_cursor="true"
        app:psw_style="StyleUnderLine"
        app:psw_text_color="@color/gray_33"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/mt_red"
        android:id="@+id/forget_pwd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="忘记密码？"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/pwd"/>
    <TextView
        android:textSize="15dp"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/claim_did"
        android:background="@drawable/shape_red_round_solid_bg"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp"
        android:text="@string/confirm"
        app:layout_constraintTop_toBottomOf="@+id/forget_pwd"/>
</androidx.constraintlayout.widget.ConstraintLayout>
