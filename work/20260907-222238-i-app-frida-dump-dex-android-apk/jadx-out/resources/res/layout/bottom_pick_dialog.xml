<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:id="@+id/vShadow"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_above="@+id/clTitle"
        android:layout_alignParentTop="true"/>
    <View
        android:id="@+id/vShadowBg"
        android:background="@color/black_alpha50"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clTitle"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rlTitle"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toTopOf="@+id/rvList">
            <TextView
                android:textSize="@dimen/common_text_size_normal"
                android:textColor="@color/common_text_color"
                android:gravity="center_vertical"
                android:id="@+id/tvTitle"
                android:paddingLeft="@dimen/common_margin_normal"
                android:paddingRight="@dimen/common_margin_normal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/common_text_row_height_normal"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/common_text_size_normal"
                android:textColor="@color/common_text_color"
                android:id="@+id/tvClose"
                android:paddingLeft="@dimen/common_margin_normal"
                android:paddingRight="@dimen/common_margin_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cancel"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:background="@color/white"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"/>
        <View
            app:layout_constraintTop_toTopOf="@+id/rvList"
            style="@style/divider_horizontal"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
