<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layout_shop_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingLeft="16dp"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/mt_black"
            android:ellipsize="end"
            android:id="@+id/tv_shop_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:layout_marginRight="56dp"
            android:maxLines="2"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_shop_tel_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@mipmap/icon_shop_tel"
            app:layout_constraintBottom_toBottomOf="@+id/tvTel"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tvTel"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#7c7c7c"
            android:gravity="center_vertical"
            android:id="@+id/tvTel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="70dp"
            app:layout_constraintLeft_toRightOf="@+id/iv_shop_tel_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tv_shop_name"/>
        <ImageView
            android:id="@+id/iv_shop_location_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:layout_marginTop="4.5dp"
            android:src="@mipmap/icon_shop_address"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTel"/>
        <TextView
            android:textSize="12dp"
            android:textColor="#7c7c7c"
            android:id="@+id/tv_shop_address"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="2dp"
            android:layout_marginTop="3dp"
            android:layout_marginRight="70dp"
            android:layout_marginBottom="15dp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintLeft_toRightOf="@+id/iv_shop_location_icon"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvTel"/>
        <ImageView
            android:id="@+id/iv_shop_distance_icon"
            android:layout_width="15dp"
            android:layout_height="15dp"
            android:src="@mipmap/icon_shop_address"
            app:layout_constraintBottom_toBottomOf="@+id/tv_shop_distance"
            app:layout_constraintRight_toLeftOf="@+id/tv_shop_distance"
            app:layout_constraintTop_toTopOf="@+id/tv_shop_distance"
            app:tint="#7c7c7c"/>
        <TextView
            android:textSize="13dp"
            android:textColor="@color/gray_7f"
            android:id="@+id/tv_shop_distance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginRight="12dp"
            android:layout_marginBottom="12dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintRight_toRightOf="parent"/>
        <ImageView
            android:id="@+id/iv_shop_default"
            android:layout_width="@dimen/size_24dp"
            android:layout_height="@dimen/size_24dp"
            android:layout_marginTop="12dp"
            android:layout_marginRight="15dp"
            android:src="@mipmap/icon_shop_default"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/iv_shop_follow"
            android:layout_width="@dimen/size_20dp"
            android:layout_height="@dimen/size_20dp"
            android:layout_marginRight="28dp"
            android:layout_marginBottom="5dp"
            app:layout_constraintBottom_toTopOf="@+id/tv_shop_distance"
            app:layout_constraintRight_toRightOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>
