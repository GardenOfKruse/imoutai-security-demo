<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ivPicContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        app:cardCornerRadius="8dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ivPic"
            android:layout_width="180dp"
            android:layout_height="240dp"
            android:scaleType="matrix"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </com.google.android.material.card.MaterialCardView>
    <View
        android:id="@+id/iconVideo"
        android:background="@mipmap/ic_community_video_cover"
        android:layout_width="50dp"
        android:layout_height="50dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivPicContainer"
        app:layout_constraintLeft_toLeftOf="@+id/ivPicContainer"
        app:layout_constraintRight_toRightOf="@+id/ivPicContainer"
        app:layout_constraintTop_toTopOf="@+id/ivPicContainer"/>
</androidx.constraintlayout.widget.ConstraintLayout>
