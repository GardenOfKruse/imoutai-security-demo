<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blank_view"
    android:background="@color/gray_f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:layout_gravity="center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="15dp"
            android:textColor="#7f7f7f"
            android:gravity="center_horizontal"
            android:layout_gravity="center"
            android:id="@+id/tv_blank_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:drawableTop="@mipmap/all_empty_comment_ic"
            android:lineSpacingExtra="4dp"/>
        <Button
            android:textSize="14dp"
            android:textColor="#333333"
            android:id="@+id/bt_blank_view"
            android:background="@drawable/shape_btn_white_footprint_go_to_homepage"
            android:visibility="gone"
            android:layout_width="62dp"
            android:layout_height="32dp"
            android:layout_marginTop="12dp"
            android:text="去逛逛"
            android:layout_below="@+id/tv_blank_view"
            android:layout_centerHorizontal="true"/>
    </RelativeLayout>
</FrameLayout>
