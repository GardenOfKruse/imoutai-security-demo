<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/default_height"
    android:layout_height="match_parent">
    <TextView
        android:textSize="@dimen/default_text_size"
        android:textColor="#7f000000"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/tv_no_more"
        android:visibility="gone"
        android:layout_width="@dimen/default_text_line_height"
        android:layout_height="match_parent"
        android:text="@string/load_no_more"/>
    <LinearLayout
        android:gravity="center"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:id="@+id/liner_loading"
        android:layout_width="wrap_content"
        android:layout_height="match_parent">
        <ProgressBar
            android:id="@+id/pb_loading"
            android:layout_width="@dimen/default_arrow_width"
            android:layout_height="@dimen/default_arrow_height"
            android:indeterminateDrawable="@drawable/refresh_loading_default"
            style="?android:attr/progressBarStyle"/>
        <TextView
            android:textSize="@dimen/default_text_size"
            android:textColor="#7f000000"
            android:gravity="center"
            android:id="@+id/tv_loading"
            android:layout_width="@dimen/default_text_line_height"
            android:layout_height="wrap_content"
            android:text="@string/load_more"/>
    </LinearLayout>
</FrameLayout>
