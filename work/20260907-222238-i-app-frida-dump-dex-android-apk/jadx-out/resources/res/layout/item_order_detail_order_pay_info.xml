<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/shape_radius_8_all_round_bg"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <TextView
        android:textSize="@dimen/yx_text_size_m"
        android:textStyle="bold"
        android:textColor="@color/gray_33"
        android:gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="53dp"
        android:layout_marginLeft="@dimen/yx_margin"
        android:layout_marginRight="@dimen/yx_margin"
        android:text="订单信息"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/order_id_container"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="订单编号"/>
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:id="@+id/order_id"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="843958560986"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/order_create_time_container"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="下单时间"/>
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:id="@+id/order_create_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/order_pay_method_container"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="支付方式"/>
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:id="@+id/order_pay_method"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="支付宝"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/order_price_container"
        android:paddingTop="@dimen/size_10dp"
        android:paddingBottom="@dimen/size_10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="商品总价"/>
        <TextView
            android:textSize="@dimen/yx_text_size_s"
            android:textColor="@color/gray_7f"
            android:gravity="center_vertical"
            android:id="@+id/order_price"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/size_12dp"
            android:text="¥4477"/>
    </LinearLayout>
</LinearLayout>
