<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:background="#f6f6f6"
        android:layout_width="match_parent"
        android:layout_height="290dp"
        android:layout_alignParentBottom="true">
        <TextView
            android:textSize="16dp"
            android:textColor="@color/gray_33"
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="17dp"
            android:text="分享至"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/btn_cancel_share"
            android:background="@mipmap/dialog_close"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginTop="23dp"
            android:layout_marginRight="17.5dp"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:gravity="center"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constrainedHeight="true"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/title">
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <com.moutai.mall.share.view.OneShareView
                    android:gravity="center"
                    android:id="@+id/osv_wx_mini_app"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    app:iconSrc="@drawable/selector_share_wechat_btn"
                    app:icon_height="50dp"
                    app:icon_width="50dp"
                    app:name="@string/share_wechat_friend"
                    app:name_color="@color/gray_33"
                    app:name_size="12dp"/>
                <com.moutai.mall.share.view.OneShareView
                    android:gravity="center"
                    android:id="@+id/osv_weixin_moment"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="67dp"
                    app:iconSrc="@drawable/selector_share_wechat_moments_btn"
                    app:icon_height="50dp"
                    app:icon_width="50dp"
                    app:name="@string/share_wechat_moments"
                    app:name_color="@color/gray_33"
                    app:name_size="12dp"/>
            </LinearLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp">
                <com.moutai.mall.share.view.OneShareView
                    android:gravity="center"
                    android:id="@+id/copy_link"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    app:iconSrc="@mipmap/share_link_icon"
                    app:icon_height="50dp"
                    app:icon_width="50dp"
                    app:name="@string/share_copy"
                    app:name_color="@color/gray_33"
                    app:name_size="12dp"/>
                <com.moutai.mall.share.view.OneShareView
                    android:gravity="center"
                    android:id="@+id/share_image"
                    android:visibility="visible"
                    android:clickable="true"
                    android:layout_width="90dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="67dp"
                    app:iconSrc="@mipmap/share_image_icon"
                    app:icon_height="50dp"
                    app:icon_width="50dp"
                    app:name="@string/share_pic"
                    app:name_color="@color/gray_33"
                    app:name_size="12dp"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</RelativeLayout>
