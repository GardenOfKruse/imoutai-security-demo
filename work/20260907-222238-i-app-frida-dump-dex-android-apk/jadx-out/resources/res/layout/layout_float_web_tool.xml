<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/root"
    android:background="@drawable/bg_view_info_control"
    android:padding="4dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginRight="15dp">
    <RelativeLayout
        android:padding="7dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="16dp"
            android:gravity="left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/wzp_debug"
            android:layout_weight="1"
            style="@style/YS.Text.Lighter"/>
        <CheckBox
            android:id="@+id/cbWindowSize"
            android:background="@drawable/selector_web_tool_size"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginRight="20dp"
            android:checked="false"
            android:button="@null"
            android:layout_toLeftOf="@+id/ivClose"/>
        <ImageView
            android:layout_gravity="right"
            android:id="@+id/ivClose"
            android:layout_width="25dp"
            android:layout_height="25dp"
            android:layout_marginRight="10dp"
            android:src="@mipmap/icon_view_info_close"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</LinearLayout>
