<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:id="@+id/rlRoot"
    android:background="@drawable/shape_radius_12_all_round_bg"
    android:paddingLeft="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="15dp"
    android:layout_marginTop="6dp"
    android:layout_marginRight="15dp"
    android:layout_marginBottom="6dp">
    <RelativeLayout
        android:layout_gravity="center_vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12.5dp"
        android:layout_marginRight="6dp"
        android:layout_marginBottom="10dp"
        android:layout_toLeftOf="@+id/vDivider"
        android:layout_centerVertical="true">
        <com.google.android.material.textview.MaterialTextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:ellipsize="end"
            android:id="@+id/tvName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:maxLines="2"/>
        <com.google.android.material.textview.MaterialTextView
            android:textSize="10dp"
            android:textColor="@color/gray_7f"
            android:ellipsize="end"
            android:id="@+id/tvAddr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="6dp"
            android:maxWidth="205dp"
            android:lines="2"
            android:drawablePadding="4dp"
            android:layout_below="@+id/tvName"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:id="@+id/tvPickup"
            android:background="@drawable/bg_pickup_store"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="6dp"
            android:layout_marginTop="5dp"
            android:lines="1"
            android:layout_below="@+id/tvAddr"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"/>
        <TextView
            android:textSize="10dp"
            android:textColor="@color/gray_7f"
            android:ellipsize="end"
            android:id="@+id/tvOpenTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lines="1"
            android:layout_below="@+id/tvPickup"
            android:layout_marginStart="6dp"/>
    </RelativeLayout>
    <View
        android:id="@+id/vDivider"
        android:background="@color/gray_d9"
        android:layout_width="1dp"
        android:layout_height="90dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        android:layout_toLeftOf="@+id/rlSelect"
        android:layout_centerVertical="true"/>
    <RelativeLayout
        android:id="@+id/rlSelect"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="3dp"
        android:layout_marginRight="3dp"
        android:layout_alignParentRight="true"
        android:layout_centerVertical="true">
        <LinearLayout
            android:layout_gravity="center_vertical"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true">
            <TextView
                android:textSize="16dp"
                android:textColor="@color/mt_gold"
                android:layout_gravity="center_horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="进店选购"/>
            <TextView
                android:textSize="10dp"
                android:textColor="@color/gray_7f"
                android:ellipsize="end"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvDistance"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lines="1"/>
        </LinearLayout>
    </RelativeLayout>
    <ImageView
        android:id="@+id/recentPic"
        android:visibility="gone"
        android:layout_width="50dp"
        android:layout_height="50dp"
        android:src="@mipmap/ic_nearby_recent"
        android:layout_alignParentTop="true"
        android:layout_alignParentRight="true"/>
</RelativeLayout>
