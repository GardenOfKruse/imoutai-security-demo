<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:background="@drawable/shape_toast_bg"
    android:paddingTop="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <ImageView
        android:layout_gravity="center_horizontal"
        android:id="@+id/toast_success_icon"
        android:visibility="gone"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="8dp"
        android:src="@drawable/toast_success_ic"/>
    <TextView
        android:textSize="@dimen/text_size_m"
        android:textColor="@color/white"
        android:gravity="center"
        android:id="@+id/toast_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="@dimen/toast_margin_h"
        android:layout_marginRight="@dimen/toast_margin_h"
        android:layout_marginBottom="@dimen/toast_margin_v"/>
</LinearLayout>
