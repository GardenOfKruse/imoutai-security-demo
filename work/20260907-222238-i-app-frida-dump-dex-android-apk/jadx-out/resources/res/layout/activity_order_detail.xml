<?xml version="1.0" encoding="utf-8"?>
<com.drake.statelayout.StateLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/order_detail_state"
    android:background="@color/gray_f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/content_container_order_detail"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/yx_margin"
            android:layout_marginRight="@dimen/yx_margin"
            android:layout_weight="1"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/order_detail_bottom_container"
            android:background="@color/white"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <FrameLayout
                android:id="@+id/pay_remain_time_container"
                android:paddingRight="@dimen/yx_margin"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_36dp">
                <com.moutai.mall.view.countdown.CountDownTextView
                    android:textSize="@dimen/yx_text_size_s"
                    android:textColor="@color/gray_33"
                    android:gravity="right"
                    android:layout_gravity="center"
                    android:id="@+id/pay_remain_time"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"/>
            </FrameLayout>
            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="@dimen/size_59dp">
                <TextView
                    android:textSize="@dimen/size_12dp"
                    android:textColor="@color/gray_33"
                    android:layout_gravity="center"
                    android:id="@+id/order_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/size_10dp"/>
                <View
                    android:layout_width="0dp"
                    android:layout_height="@dimen/one_px"
                    android:layout_weight="1"/>
                <TextView
                    android:textSize="@dimen/size_14dp"
                    android:textColor="@color/mt_red"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/order_detail_cancel"
                    android:background="@drawable/shape_order_detail_other_btn"
                    android:paddingLeft="@dimen/size_32dp"
                    android:paddingRight="@dimen/size_32dp"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/size_36dp"
                    android:layout_marginRight="@dimen/size_8dp"
                    android:text="@string/order_detail_pay_cancel"/>
                <com.google.android.material.button.MaterialButton
                    android:visibility="gone"
                    android:layout_width="@dimen/size_108dp"
                    android:layout_height="@dimen/size_36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/white"
                    app:cornerRadius="@dimen/size_16dp"
                    app:strokeColor="@color/mt_gold"
                    app:strokeWidth="@dimen/one_px"/>
                <TextView
                    android:textSize="@dimen/size_14dp"
                    android:textColor="@color/white"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:id="@+id/order_detail_pay"
                    android:background="@drawable/shape_place_order_pay_btn"
                    android:layout_width="@dimen/size_108dp"
                    android:layout_height="@dimen/size_36dp"
                    android:layout_marginRight="@dimen/size_10dp"
                    android:text="@string/order_detail_pay"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</com.drake.statelayout.StateLayout>
