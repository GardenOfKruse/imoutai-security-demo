<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivAvatarFrame"
        android:layout_width="49.5dp"
        android:layout_height="49.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintLeft_toLeftOf="@+id/ivAvatar"
        app:layout_constraintRight_toRightOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/gray_33"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:id="@+id/tvName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="2"
        android:includeFontPadding="false"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintEnd_toStartOf="@+id/btFollow"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
        app:layout_goneMarginEnd="20dp"/>
    <ImageView
        android:id="@+id/ivAuth"
        android:visibility="gone"
        android:layout_width="14dp"
        android:layout_height="15dp"
        android:src="@mipmap/icon_community_auth"
        android:layout_marginStart="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvName"
        app:layout_constraintStart_toEndOf="@+id/tvName"
        app:layout_constraintTop_toTopOf="@+id/tvName"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="14dp"
        android:textColor="@color/mt_red"
        android:gravity="center"
        android:id="@+id/btFollow"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="15dp"
        app:backgroundTint="@color/white"
        app:cornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
        app:strokeColor="@color/mt_red"
        app:strokeWidth="1px"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/gray_33"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="10dp"
        android:layout_marginRight="15dp"
        android:maxLines="2"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintTop_toBottomOf="@+id/ivAvatar"/>
    <TextView
        android:textSize="16dp"
        android:textColor="@color/gray_33"
        android:id="@+id/tvContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="15dp"
        android:lineSpacingExtra="@dimen/community_content_line_space"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintTop_toBottomOf="@+id/tvTitle"/>
    <TextView
        android:textSize="14dp"
        android:textColor="#588be4"
        android:id="@+id/tvFold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginTop="7dp"
        android:layout_marginRight="15dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvContent"/>
    <include
        android:id="@+id/includeLink"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="7dp"
        android:layout_marginStart="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tvFold"
        layout="@layout/item_community_note_link"/>
</androidx.constraintlayout.widget.ConstraintLayout>
