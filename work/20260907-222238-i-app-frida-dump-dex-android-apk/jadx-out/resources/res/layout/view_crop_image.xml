<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/black"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/navigation_bar_container"
        android:background="@color/green_light_actionbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/action_bar_height"/>
    <com.netease.hearttouch.htimagepicker.core.imagecrop.view.ImageCropView
        android:id="@+id/cropable_image_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/radius_45"/>
</RelativeLayout>
