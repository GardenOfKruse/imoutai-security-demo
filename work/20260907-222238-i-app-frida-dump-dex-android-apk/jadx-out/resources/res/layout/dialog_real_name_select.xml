<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@color/black_alpha60"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_white_radius_2dp"
        android:paddingLeft="20dp"
        android:paddingTop="24dp"
        android:paddingRight="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp">
            <TextView
                android:textSize="20dp"
                android:textStyle="bold"
                android:textColor="@color/gray_33"
                android:layout_gravity="center_horizontal"
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="实名认证服务须知"/>
            <ImageView
                android:layout_gravity="end|center_vertical"
                android:id="@+id/close"
                android:layout_width="@dimen/size_24dp"
                android:layout_height="@dimen/size_24dp"
                android:src="@mipmap/ic_close_arrow"/>
        </FrameLayout>
        <com.moutai.mall.module.certification.ObservableScrollView
            android:id="@+id/scrollView"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/gray_33"
                    android:gravity="start"
                    android:id="@+id/agreement_tv1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
                <TextView
                    android:textSize="14dp"
                    android:textColor="@color/gray_33"
                    android:gravity="start"
                    android:id="@+id/agreement_tv2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"/>
            </LinearLayout>
        </com.moutai.mall.module.certification.ObservableScrollView>
        <View
            android:background="@mipmap/real_name_tips_dialog_mask"
            android:layout_width="match_parent"
            android:layout_height="20dp"
            android:layout_marginTop="-20dp"/>
        <LinearLayout
            android:gravity="center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">
            <CheckBox
                android:id="@+id/agree"
                android:background="@drawable/select_certificate_check"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginTop="2dp"
                android:checked="false"
                android:button="@null"
                android:layout_marginEnd="@dimen/size_6dp"/>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/gray_33"
                android:id="@+id/agree_tv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="我已充分理解并同意《实名认证服务须知》\10及《i茅台身份认证服务协议》"
                android:includeFontPadding="false"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/bt_next"
            android:background="@drawable/selector_cc_golden"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginLeft="35dp"
            android:layout_marginTop="35dp"
            android:layout_marginRight="35dp"
            android:layout_marginBottom="34dp"/>
    </LinearLayout>
</LinearLayout>
