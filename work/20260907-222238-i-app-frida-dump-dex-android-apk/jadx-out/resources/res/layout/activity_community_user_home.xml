<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp">
            <com.google.android.material.appbar.CollapsingToolbarLayout
                android:id="@+id/collapsingToolbarLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:minHeight="128dp"
                app:layout_scrollFlags="exitUntilCollapsed|scroll">
                <include
                    android:id="@+id/layoutCommunityUserHomeHeader"
                    app:layout_collapseMode="pin"
                    layout="@layout/item_community_user_homepage_header"/>
                <com.google.android.material.tabs.TabLayout
                    android:layout_gravity="bottom"
                    android:id="@+id/tabLayout"
                    android:background="@drawable/bg_community_user_tab_layout"
                    android:layout_width="match_parent"
                    android:layout_height="39.5dp"
                    app:tabIndicator="@drawable/shape_community_user_tab_indicator"
                    app:tabIndicatorColor="#cf2d26"
                    app:tabIndicatorFullWidth="false"
                    app:tabMode="fixed"
                    app:tabRippleColor="@null"
                    app:tabSelectedTextColor="@color/gray_33"
                    app:tabTextColor="@color/gray_7f"/>
            </com.google.android.material.appbar.CollapsingToolbarLayout>
        </com.google.android.material.appbar.AppBarLayout>
        <LinearLayout
            android:orientation="vertical"
            android:background="@drawable/bg_community_user_tab_layout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">
            <View
                android:background="@color/gray_ee"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"/>
            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>
        </LinearLayout>
    </androidx.coordinatorlayout.widget.CoordinatorLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/csHeader"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            app:layout_constraintBottom_toBottomOf="parent">
            <ImageView
                android:id="@+id/ivTitleBack"
                android:padding="8dp"
                android:layout_width="24.5dp"
                android:layout_height="32dp"
                android:layout_marginLeft="7dp"
                android:src="@mipmap/icon_note_detail_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <TextView
                android:textSize="16dp"
                android:textColor="@color/gray_33"
                android:ellipsize="end"
                android:id="@+id/tvTitleName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:lines="1"
                app:layout_constraintBottom_toBottomOf="@+id/ivTitleBack"
                app:layout_constraintLeft_toRightOf="@+id/ivTitleBack"
                app:layout_constraintRight_toLeftOf="@+id/btnTitleFollow"
                app:layout_constraintTop_toTopOf="@+id/ivTitleBack"/>
            <Button
                android:textSize="14dp"
                android:textColor="@color/white"
                android:gravity="center"
                android:id="@+id/btnTitleFollow"
                android:background="@drawable/shape_note_detail_follow_btn"
                android:visibility="gone"
                android:layout_width="60dp"
                android:layout_height="28dp"
                android:layout_marginRight="15dp"
                app:backgroundTint="@null"
                app:layout_constraintBottom_toBottomOf="@+id/ivTitleBack"
                app:layout_constraintRight_toRightOf="parent"
                app:layout_constraintTop_toTopOf="@+id/ivTitleBack"/>
            <View
                android:background="@color/gray_ee"
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintLeft_toLeftOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
