<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutRoot"
    android:background="@color/black"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.moutai.mall.module.culture.NoteDetailHeaderLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.moutai.mall.video.core.YXVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/includeShareBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader"
        app:videoBackgroundColor="@color/black"/>
    <ImageView
        android:id="@+id/ivToggleFullscreen"
        android:visibility="gone"
        android:layout_width="120dp"
        android:layout_height="34dp"
        android:src="@mipmap/icon_community_video_toggle_fullscreen"
        app:layout_constraintBottom_toTopOf="@+id/guideline"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"/>
    <TextView
        android:textSize="16dp"
        android:textStyle="bold"
        android:textColor="@color/white_alpha90"
        android:ellipsize="end"
        android:id="@+id/tvTitle"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="7dp"
        android:lines="1"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintBottom_toTopOf="@+id/tvContent"
        app:layout_constraintHeight_max="165dp"/>
    <TextView
        android:scrollbarSize="2dp"
        android:scrollbarThumbVertical="@drawable/shape_community_text_scroll_bar"
        android:scrollbarStyle="outsideInset"
        android:textSize="15dp"
        android:textColor="@color/white_alpha90"
        android:id="@+id/tvContent"
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="7dp"
        android:lineSpacingExtra="@dimen/community_content_line_space"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintBottom_toTopOf="@+id/tvFold"
        app:layout_constraintHeight_max="165dp"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gray_a1"
        android:id="@+id/tvTimeInfo"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/tvFold"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tvFold"/>
    <TextView
        android:textSize="13dp"
        android:textColor="@color/gray_a1"
        android:ellipsize="end"
        android:id="@+id/tvIpInfo"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="13dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:drawableLeft="@mipmap/ic_addr_gray"
        android:drawablePadding="2dp"
        android:drawableTint="@color/gray_a1"
        app:layout_constraintBottom_toBottomOf="@+id/tvFold"
        app:layout_constraintLeft_toRightOf="@+id/tvTimeInfo"
        app:layout_constraintRight_toLeftOf="@+id/tvFold"
        app:layout_constraintTop_toTopOf="@+id/tvFold"/>
    <TextView
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/tvFold"
        android:paddingBottom="5dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:layout_marginRight="15dp"
        android:layout_marginBottom="45dp"
        android:layout_marginHorizontal="15dp"
        app:layout_constraintBottom_toTopOf="@+id/includeShareBar"
        app:layout_constraintRight_toRightOf="parent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/guideline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.65"/>
    <com.drake.statelayout.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/includeShareBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader">
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"/>
    </com.drake.statelayout.StateLayout>
    <com.moutai.mall.module.culture.video.CommunityVideoSeekBar
        android:id="@+id/seekBarCommunityVideo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/includeShareBar"/>
    <include
        android:id="@+id/includeShareBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/community_share_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        layout="@layout/item_community_note_bottom_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
