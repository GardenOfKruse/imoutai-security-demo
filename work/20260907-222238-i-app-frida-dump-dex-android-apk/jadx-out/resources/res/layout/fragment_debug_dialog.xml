<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/common_page_bg_color"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:id="@+id/flTitle"
        android:background="@color/white"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <RelativeLayout
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:id="@+id/rlTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="@dimen/common_text_size_normal"
                android:textColor="@color/common_text_color"
                android:gravity="center_vertical"
                android:id="@+id/tvTitle"
                android:paddingLeft="@dimen/common_margin_normal"
                android:paddingRight="@dimen/common_margin_normal"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/common_text_row_height_normal"
                android:text="内测菜单"
                android:layout_centerHorizontal="true"/>
            <TextView
                android:textSize="@dimen/common_text_size_normal"
                android:textColor="@color/common_text_color"
                android:id="@+id/tvClose"
                android:paddingLeft="@dimen/common_margin_normal"
                android:paddingRight="@dimen/common_margin_normal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/close"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
    </FrameLayout>
    <com.xunfeng.lab.baseview.InputGroupView
        android:id="@+id/inputGroupView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/flTitle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
