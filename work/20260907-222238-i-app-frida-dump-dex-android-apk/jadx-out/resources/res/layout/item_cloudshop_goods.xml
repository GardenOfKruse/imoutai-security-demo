<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:background="@drawable/bg_card_white_top_radius"
    android:padding="0dp"
    android:clipChildren="true"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="4dp"
    android:layout_marginTop="4dp"
    android:layout_marginRight="4dp"
    android:layout_marginBottom="4dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="4dp">
    <ImageView
        android:id="@+id/goods_pic"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:scaleType="centerCrop"/>
    <TextView
        android:textSize="13sp"
        android:textStyle="normal"
        android:textColor="#333333"
        android:gravity="center"
        android:id="@+id/name"
        android:paddingLeft="8dp"
        android:paddingTop="4dp"
        android:paddingRight="8dp"
        android:paddingBottom="4dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:minHeight="30dp"
        android:singleLine="false"
        android:lineSpacingExtra="2dp"
        android:textAlignment="textStart"/>
    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/layoutTag"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="0dp"
        android:layout_marginBottom="4dp"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingLeft="8dp"
        android:paddingRight="8dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp">
        <TextView
            android:textSize="12sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvRetailPrefix"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1.2dp"
            android:layout_marginRight="0dp"
            android:text="零售价："
            android:includeFontPadding="false"/>
        <TextView
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_gravity="center_vertical"
            android:id="@+id/tvPromPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"/>
        <TextView
            android:textSize="12sp"
            android:textColor="#999999"
            android:layout_gravity="bottom"
            android:id="@+id/tvLinePrice"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="4dp"
            android:layout_marginBottom="0.5dp"/>
    </LinearLayout>
</LinearLayout>
