<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <ImageView
        android:id="@+id/ivAvatar"
        android:layout_width="42.5dp"
        android:layout_height="42.5dp"
        android:layout_marginTop="15dp"
        android:layout_marginStart="15dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <ImageView
        android:id="@+id/ivAvatarFrame"
        android:layout_width="49.5dp"
        android:layout_height="49.5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintLeft_toLeftOf="@+id/ivAvatar"
        app:layout_constraintRight_toRightOf="@+id/ivAvatar"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/gray_33"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toTopOf="@+id/tvDesc"
        app:layout_constraintLeft_toRightOf="@+id/ivAvatar"
        app:layout_constraintRight_toLeftOf="@+id/btFollow"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
        app:layout_goneMarginRight="20dp"/>
    <TextView
        android:textSize="12dp"
        android:textColor="@color/gray_66"
        android:ellipsize="end"
        android:gravity="start"
        android:id="@+id/tvDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:lines="1"
        android:includeFontPadding="false"
        android:layout_marginEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintLeft_toLeftOf="@+id/tvName"
        app:layout_constraintRight_toLeftOf="@+id/btFollow"
        app:layout_constraintTop_toBottomOf="@+id/tvName"
        app:layout_goneMarginRight="20dp"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="14dp"
        android:textColor="@color/mt_red"
        android:gravity="center"
        android:id="@+id/btFollow"
        android:layout_width="60dp"
        android:layout_height="28dp"
        android:includeFontPadding="false"
        android:layout_marginEnd="15dp"
        app:backgroundTint="@color/white"
        app:cornerRadius="5dp"
        app:layout_constraintBottom_toBottomOf="@+id/ivAvatar"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="@+id/ivAvatar"
        app:strokeColor="@color/mt_red"
        app:strokeWidth="1px"/>
</androidx.constraintlayout.widget.ConstraintLayout>
