<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:background="@color/gray_e5"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
    <LinearLayout
        android:orientation="vertical"
        android:background="@drawable/shape_radius_8_all_round_bg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="44dp">
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/yx_text_common"
                android:gravity="center"
                android:id="@+id/reservation_time_prefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="15dp"
                android:text="@string/reservation_time"
                android:layout_centerVertical="true"/>
            <TextView
                android:textSize="14dp"
                android:textStyle="bold"
                android:textColor="@color/yx_text_common"
                android:ellipsize="end"
                android:gravity="center"
                android:id="@+id/date_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:lines="1"
                android:layout_toRightOf="@+id/reservation_time_prefix"
                android:layout_centerVertical="true"/>
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="4dp"
                android:layout_toLeftOf="@+id/draw_status"
                android:layout_toRightOf="@+id/date_time"
                android:layout_centerVertical="true">
                <TextView
                    android:textSize="10dp"
                    android:textColor="@color/white"
                    android:ellipsize="end"
                    android:id="@+id/session_tag"
                    android:paddingLeft="4dp"
                    android:paddingTop="1.5dp"
                    android:paddingRight="4dp"
                    android:paddingBottom="1.5dp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:lines="1"
                    android:paddingHorizontal="4dp"
                    android:paddingVertical="1.5dp"/>
            </FrameLayout>
            <TextView
                android:textSize="14dp"
                android:textColor="@color/yx_text_common"
                android:gravity="center"
                android:id="@+id/draw_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="15dp"
                android:text="@string/waiting_for_draw"
                android:layout_alignParentRight="true"
                android:layout_centerVertical="true"/>
        </RelativeLayout>
        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/mt_goods_pic"
                android:layout_width="@dimen/size_90dp"
                android:layout_height="@dimen/size_90dp"
                android:layout_marginLeft="@dimen/size_12dp"
                android:layout_marginTop="@dimen/size_15dp"
                android:layout_marginBottom="@dimen/size_15dp"/>
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/size_20dp"
                android:layout_marginRight="@dimen/size_14dp"
                android:layout_weight="1">
                <TextView
                    android:textSize="15dp"
                    android:textColor="@color/gray_33"
                    android:ellipsize="end"
                    android:id="@+id/mt_goods_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/size_20dp"
                    android:maxLines="2"/>
                <Space
                    android:layout_width="0dp"
                    android:layout_height="0dp"
                    android:layout_weight="1"/>
                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/size_20dp">
                    <TextView
                        android:textSize="@dimen/yx_text_size_l"
                        android:textStyle="bold"
                        android:textColor="@color/gray_33"
                        android:id="@+id/mt_goods_price"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                    <View
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1"/>
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/mt_goods_num_prefix"
                        android:layout_width="@dimen/size_6dp"
                        android:layout_height="@dimen/size_6dp"
                        android:layout_marginTop="@dimen/size_3dp"
                        android:layout_marginRight="@dimen/size_3dp"
                        android:src="@mipmap/pay_goods_num_prefix"/>
                    <TextView
                        android:textSize="@dimen/yx_text_size_l"
                        android:textStyle="bold"
                        android:textColor="@color/gray_33"
                        android:id="@+id/mt_goods_num"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"/>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <View
        android:id="@+id/bottom_space"
        android:background="@color/gray_e5"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="12dp"/>
</LinearLayout>
