<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root_view"
    android:background="@color/gray_f8"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.drake.statelayout.StateLayout
        android:id="@+id/pay_result_state"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <FrameLayout
                android:background="@mipmap/order_pay_result_header"
                android:layout_width="match_parent"
                android:layout_height="260dp"/>
            <FrameLayout
                android:id="@+id/payed_order_status_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="138dp">
                <LinearLayout
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:background="@drawable/shape_radius_8_top_round_bg"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/size_45dp">
                    <TextView
                        android:textSize="@dimen/size_24dp"
                        android:textColor="@color/gray_33"
                        android:id="@+id/pay_result_desc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_77dp"/>
                    <TextView
                        android:textSize="@dimen/yx_text_size_xm"
                        android:textStyle="bold"
                        android:textColor="@color/gray_33"
                        android:gravity="center"
                        android:id="@+id/payFailTip"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/size_16dp"
                        android:text="@string/pay_fail_tip"/>
                    <com.google.android.material.button.MaterialButton
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:id="@+id/checkOrderId"
                        android:layout_width="270dp"
                        android:layout_height="38dp"
                        android:layout_marginTop="@dimen/size_50dp"
                        android:layout_marginBottom="24dp"
                        android:text="@string/check_order"
                        app:backgroundTint="@color/mt_red"
                        app:cornerRadius="1dp"/>
                </LinearLayout>
                <View
                    android:layout_gravity="center_horizontal"
                    android:id="@+id/payed_order_status"
                    android:background="@mipmap/order_pay_result_status_waiting_bg"
                    android:layout_width="@dimen/size_90dp"
                    android:layout_height="@dimen/size_90dp"/>
            </FrameLayout>
        </FrameLayout>
    </com.drake.statelayout.StateLayout>
    <com.moutai.mall.view.NavigationBar
        android:id="@+id/nav_bar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/size_44dp"/>
</FrameLayout>
