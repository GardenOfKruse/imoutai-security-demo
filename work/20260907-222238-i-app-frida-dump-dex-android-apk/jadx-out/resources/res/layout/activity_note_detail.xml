<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.moutai.mall.module.culture.NoteDetailHeaderLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginTop="44dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <View
        android:id="@+id/lineHeader"
        android:background="@color/gray_ee"
        android:layout_width="match_parent"
        android:layout_height="0.5dp"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/layoutHeader"/>
    <com.drake.statelayout.StateLayout
        android:id="@+id/stateLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/noteBottomBar"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lineHeader">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerviewNoteDetail"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>
    </com.drake.statelayout.StateLayout>
    <include
        android:id="@+id/noteBottomBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/community_share_bar_height"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        layout="@layout/item_community_note_bottom_bar"/>
</androidx.constraintlayout.widget.ConstraintLayout>
