<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:screenOrientation="portrait"
    android:orientation="vertical"
    android:background="@color/mtappbg"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:id="@+id/layout_titlebar"
        android:background="@color/mtappbg"
        android:layout_width="match_parent"
        android:layout_height="30dp">
        <TextView
            android:textSize="20dp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:ellipsize="marquee"
            android:gravity="center"
            android:id="@+id/text_title"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:text="收银台"
            android:singleLine="true"/>
        <Button
            android:ellipsize="end"
            android:id="@+id/button_esc"
            android:background="@null"
            android:layout_width="60dp"
            android:layout_height="match_parent"
            android:layout_marginLeft="10dp"
            android:button="@null"
            android:singleLine="true"
            android:drawableLeft="@drawable/esc_btn"/>
    </RelativeLayout>
    <ScrollView
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="52dp">
                <TextView
                    android:textSize="36dp"
                    android:textStyle="bold"
                    android:textColor="#333333"
                    android:id="@+id/amt_sum"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="¥1499"/>
                <TextView
                    android:textSize="16dp"
                    android:textColor="#7f7f7f"
                    android:id="@+id/timeout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="剩下 00:29:56"/>
            </LinearLayout>
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:background="@drawable/card_edge"
                android:padding="20dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="18dp">
                <LinearLayout
                    android:gravity="left"
                    android:orientation="horizontal"
                    android:background="#ffffff"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:background="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="订单编号: "/>
                    <TextView
                        android:textSize="16dp"
                        android:textStyle="bold"
                        android:textColor="#000000"
                        android:id="@+id/text_sales"
                        android:background="#ffffff"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="123456"/>
                </LinearLayout>
                <RadioGroup
                    android:orientation="vertical"
                    android:id="@+id/radio_type"
                    android:background="#ffffff"
                    android:paddingRight="20dp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <RadioButton
                        android:textSize="16dp"
                        android:textColor="#000000"
                        android:id="@+id/radio_ysf"
                        android:tag="80"
                        android:background="@drawable/radio_ysf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:checked="true"
                        android:button="@null"
                        android:text="云闪付"
                        android:drawableLeft="@drawable/radio_btn"
                        android:drawablePadding="52dp"/>
                    <RadioButton
                        android:textSize="16dp"
                        android:textColor="#000000"
                        android:id="@+id/radio_gzbank"
                        android:tag="81"
                        android:background="@drawable/radio_gzbank"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:button="@null"
                        android:text="贵州银行"
                        android:drawableLeft="@drawable/radio_btn"
                        android:drawablePadding="52dp"/>
                    <RadioButton
                        android:textSize="16dp"
                        android:textColor="#000000"
                        android:id="@+id/radio_wx"
                        android:tag="60"
                        android:background="@drawable/radio_wx"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:button="@null"
                        android:text="微信支付"
                        android:drawableLeft="@drawable/radio_btn"
                        android:drawablePadding="52dp"/>
                    <RadioButton
                        android:textSize="16dp"
                        android:textColor="#000000"
                        android:id="@+id/radio_zfb"
                        android:tag="70"
                        android:background="@drawable/radio_zfb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:button="@null"
                        android:text="支付宝"
                        android:drawableLeft="@drawable/radio_btn"
                        android:drawablePadding="52dp"/>
                </RadioGroup>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
    <LinearLayout
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/card_edge"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="10dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="#ff0000"
            android:gravity="center"
            android:id="@+id/payment_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="点击”立即付款“后，请在30秒内完成支付，超时需要回到收银台重新发起支付"/>
        <Button
            android:textSize="20dp"
            android:textColor="#ffffff"
            android:id="@+id/btn_pay"
            android:background="@drawable/btn_pay_selector"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="立即付款"
            style="?android:attr/borderlessButtonStyle"/>
    </LinearLayout>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="40dp"
        android:layout_marginRight="40dp"
        android:layout_marginBottom="20dp"/>
</LinearLayout>
