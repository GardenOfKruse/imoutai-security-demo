<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingLeft="15dp"
    android:paddingTop="12dp"
    android:paddingRight="15dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <View
        android:id="@+id/vBg"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:id="@+id/vTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="15dp"
        android:text="我的申购单"
        app:layout_constraintBottom_toBottomOf="@+id/vBg"
        app:layout_constraintLeft_toLeftOf="@+id/vBg"
        app:layout_constraintTop_toTopOf="@+id/vBg"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/white"
        android:gravity="right"
        android:id="@+id/vHint"
        android:paddingRight="14dp"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginLeft="15dp"
        app:layout_constraintBottom_toBottomOf="@+id/vBg"
        app:layout_constraintLeft_toRightOf="@+id/vTitle"
        app:layout_constraintRight_toLeftOf="@+id/vArrow"
        app:layout_constraintTop_toTopOf="@+id/vBg"/>
    <View
        android:id="@+id/vArrow"
        android:background="@mipmap/right_arrow_white"
        android:layout_width="7dp"
        android:layout_height="12dp"
        android:layout_marginRight="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/vBg"
        app:layout_constraintRight_toRightOf="@+id/vBg"
        app:layout_constraintTop_toTopOf="@+id/vBg"/>
</androidx.constraintlayout.widget.ConstraintLayout>
