<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:paddingBottom="30dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:id="@+id/vIcon"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="24dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_99"
            android:gravity="center"
            android:id="@+id/tvHelpHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/vIcon"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/gray_33"
            android:gravity="center"
            android:id="@+id/tvHelpMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="20dp"
            android:layout_marginRight="50dp"
            android:layout_marginHorizontal="50dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHelpHint"/>
        <TextView
            android:textSize="12dp"
            android:textColor="@color/gray_88"
            android:gravity="center"
            android:id="@+id/tvNoticeHint"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="30dp"
            android:layout_marginHorizontal="30dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvHelpMessage"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="16dp"
            android:textColor="@color/white"
            android:gravity="center"
            android:id="@+id/tvStart"
            android:layout_width="200dp"
            android:layout_height="44dp"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="30dp"
            android:text="立即扫码"
            app:backgroundTint="@color/mt_red"
            app:cornerRadius="25dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvNoticeHint"/>
        <TextView
            android:textSize="16dp"
            android:textColor="@color/gray_33"
            android:gravity="center"
            android:id="@+id/tvInputMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="50dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="50dp"
            android:text="条形码破损/撕毁无法识别"
            android:layout_marginHorizontal="50dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStart"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14dp"
            android:textColor="@color/mt_red"
            android:id="@+id/tvInputStart"
            android:layout_width="150dp"
            android:layout_height="36dp"
            android:layout_marginTop="10dp"
            android:text="手动输入"
            app:backgroundTint="@color/white"
            app:cornerRadius="25dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInputMessage"
            app:strokeColor="@color/mt_red"
            app:strokeWidth="1dp"/>
        <TextView
            android:textSize="14dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:id="@+id/tvStepTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="50dp"
            android:layout_marginRight="32dp"
            android:text="查询步骤"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvInputStart"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/black_55"
            android:id="@+id/tvStepContent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginLeft="32dp"
            android:layout_marginTop="10dp"
            android:layout_marginRight="32dp"
            android:layout_marginHorizontal="32dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStepTitle"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="14dp"
            android:textColor="@color/mt_red"
            android:id="@+id/tvJumpHelp"
            android:layout_width="150dp"
            android:layout_height="36dp"
            android:layout_marginTop="30dp"
            android:text="使用帮助"
            app:backgroundTint="@color/white"
            app:cornerRadius="25dp"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/tvStepContent"
            app:strokeColor="@color/mt_red"
            app:strokeWidth="1dp"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
