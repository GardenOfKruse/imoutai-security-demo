<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@color/s_color_FFFFFF"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:paddingLeft="15dp"
        android:paddingRight="15dp"
        android:layout_width="match_parent"
        android:layout_height="45dp">
        <TextView
            android:textSize="@dimen/s_font_size_14"
            android:textColor="@android:color/holo_blue_dark"
            android:layout_gravity="left"
            android:id="@+id/done"
            android:paddingTop="10dp"
            android:paddingRight="20dp"
            android:paddingBottom="10dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="完成"/>
        <TextView
            android:textSize="@dimen/s_font_size_16"
            android:gravity="center"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="埋点log查看"/>
        <LinearLayout
            android:layout_gravity="right"
            android:layout_width="wrap_content"
            android:layout_height="match_parent">
            <TextView
                android:textSize="@dimen/s_font_size_14"
                android:textColor="@android:color/holo_blue_dark"
                android:gravity="center"
                android:id="@+id/clean"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="清空"/>
            <TextView
                android:textSize="@dimen/s_font_size_14"
                android:textColor="@android:color/holo_blue_dark"
                android:gravity="center"
                android:id="@+id/refresh"
                android:paddingLeft="10dp"
                android:paddingRight="10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="刷新"/>
        </LinearLayout>
    </FrameLayout>
    <com.netease.libs.collector.visualtools.scrollablepaneltool.scrollablepanel.ScrollablePanel
        android:id="@+id/scrollable_panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="45dp"/>
</FrameLayout>
