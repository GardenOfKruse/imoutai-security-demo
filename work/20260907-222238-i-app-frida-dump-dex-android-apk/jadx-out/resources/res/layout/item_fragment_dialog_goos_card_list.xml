<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/shape_radius_8_all_round_bg"
    android:layout_width="match_parent"
    android:layout_height="141dp">
    <ImageView
        android:id="@+id/ivPic"
        android:layout_width="102dp"
        android:layout_height="102dp"
        android:layout_marginStart="10dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="14dp"
        android:textColor="@color/gray_66"
        android:ellipsize="end"
        android:id="@+id/tvName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="15dp"
        android:lines="2"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="17.5dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/ivPic"
        app:layout_constraintTop_toTopOf="@+id/ivPic"
        app:layout_goneMarginEnd="26dp"/>
    <TextView
        android:textSize="15dp"
        android:textStyle="bold"
        android:textColor="@color/gray_33"
        android:ellipsize="end"
        android:id="@+id/tvPrice"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:lines="1"
        app:layout_constraintBottom_toBottomOf="@+id/vBuy"
        app:layout_constraintStart_toEndOf="@+id/ivPic"
        app:layout_constraintStart_toStartOf="@+id/tvName"/>
    <View
        android:id="@+id/vBuy"
        android:background="@mipmap/ic_goods_card_buy"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginBottom="24dp"
        android:layout_marginEnd="23dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
