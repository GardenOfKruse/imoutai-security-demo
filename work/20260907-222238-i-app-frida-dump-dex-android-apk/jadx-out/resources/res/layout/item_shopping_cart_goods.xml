<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <RelativeLayout
        android:id="@+id/rlGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/vSelect"
            android:background="@drawable/selector_shopping_cart_item_choose"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginLeft="10dp"
            android:layout_centerVertical="true"/>
        <ImageView
            android:id="@+id/img_holder"
            android:background="@color/gray_f4"
            android:visibility="gone"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_toRightOf="@+id/vSelect"/>
        <ImageView
            android:id="@+id/ivImage"
            android:layout_width="90dp"
            android:layout_height="90dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_toRightOf="@+id/vSelect"/>
        <TextView
            android:textSize="12dp"
            android:id="@+id/tvLimitHint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6.5dp"
            android:layout_marginBottom="10dp"
            android:layout_below="@+id/ivImage"
            android:layout_alignLeft="@+id/ivImage"/>
        <TextView
            android:textSize="14dp"
            android:textColor="@color/white"
            android:ellipsize="end"
            android:gravity="center"
            android:id="@+id/vInvalidShadow"
            android:background="@drawable/shape_circle_balck_alpha_50_bg"
            android:padding="5dp"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_marginLeft="16dp"
            android:layout_marginTop="16dp"
            android:lines="1"
            android:layout_alignLeft="@+id/ivImage"
            android:layout_alignTop="@+id/ivImage"/>
        <TextView
            android:textSize="15dp"
            android:textColor="@color/gray_33"
            android:ellipsize="end"
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="17dp"
            android:layout_marginRight="10dp"
            android:maxLines="2"
            android:layout_toRightOf="@+id/ivImage"
            android:layout_alignParentRight="true"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/flTagContainer"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="2dp"
            android:layout_marginRight="10dp"
            android:layout_toRightOf="@+id/ivImage"
            android:layout_below="@+id/tvName"
            app:alignItems="center"
            app:flexDirection="row"
            app:flexWrap="wrap"
            app:itemSpacing="4dp"
            app:justifyContent="flex_start"
            app:lineSpacing="2dp"/>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:ellipsize="end"
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginTop="8dp"
            android:layout_marginRight="10dp"
            android:layout_marginBottom="17dp"
            android:singleLine="true"
            android:layout_toLeftOf="@+id/llCountEditor"
            android:layout_toRightOf="@+id/ivImage"
            android:layout_below="@+id/flTagContainer"/>
        <FrameLayout
            android:id="@+id/flCountEditor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="-10dp"
            android:layout_marginTop="-10dp"
            android:layout_marginRight="-10dp"
            android:layout_marginBottom="-10dp"
            android:layout_alignLeft="@+id/llCountEditor"
            android:layout_alignTop="@+id/llCountEditor"
            android:layout_alignRight="@+id/llCountEditor"
            android:layout_alignBottom="@+id/llCountEditor"/>
        <LinearLayout
            android:orientation="horizontal"
            android:id="@+id/llCountEditor"
            android:background="@mipmap/bg_cart_count_small_editor_111"
            android:visibility="gone"
            android:layout_width="88dp"
            android:layout_height="26dp"
            android:layout_marginRight="10dp"
            android:weightSum="3"
            android:layout_alignTop="@+id/tvPrice"
            android:layout_alignParentRight="true">
            <View
                android:id="@+id/vCountMinus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <TextView
                android:textSize="12dp"
                android:textColor="@color/gray_33"
                android:gravity="center"
                android:id="@+id/tvCount"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:text="999"
                android:lines="1"
                android:layout_weight="1"/>
            <View
                android:id="@+id/vCountPlus"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
        </LinearLayout>
        <TextView
            android:textSize="16dp"
            android:textStyle="bold"
            android:textColor="@color/gray_33"
            android:id="@+id/tvAmount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:drawableLeft="@mipmap/ic_shopping_cart_amount"
            android:layout_alignTop="@+id/tvPrice"
            android:layout_alignParentRight="true"/>
    </RelativeLayout>
</FrameLayout>
