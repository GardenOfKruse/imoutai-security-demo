<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.netease.hearttouch.htimagepicker.core.view.PhotoViewViewPager
        android:id="@+id/image_fullscreen_pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <RelativeLayout
        android:id="@+id/layout_action"
        android:background="@color/bg_transparent_grey"
        android:layout_width="match_parent"
        android:layout_height="59dp"
        android:layout_alignParentBottom="true">
        <Button
            android:textSize="16sp"
            android:textColor="@color/white"
            android:id="@+id/btn_finish"
            android:background="@drawable/shape_round_30dp_green_normal"
            android:paddingLeft="15dp"
            android:paddingRight="15dp"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="39dp"
            android:layout_marginRight="13dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"/>
    </RelativeLayout>
</RelativeLayout>
